{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "restaurante.taseca.tech"
        }
      ],
      "destination": "/restaurantes",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "restaurantes.taseca.tech"
        }
      ],
      "destination": "/restaurantes",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.taseca.tech"
        }
      ],
      "destination": "/taseca",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "taseca.taseca.tech"
        }
      ],
      "destination": "/taseca",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/restaurantes",
      "destination": "/restaurantes.html"
    },
    {
      "source": "/taseca",
      "destination": "/taseca-admin.html"
    },
    {
      "source": "/taseca/:empresa/panel",
      "destination": "/empleados.html"
    },
    {
      "source": "/taseca/:empresa/mesa",
      "destination": "/mesa.html"
    },
    {
      "source": "/taseca/:empresa/cierre",
      "destination": "/cierre.html"
    },
    {
      "source": "/taseca/:empresa",
      "destination": "/index.html"
    },
    {
      "source": "/:empresa/panel",
      "destination": "/empleados.html"
    },
    {
      "source": "/:empresa/mesa",
      "destination": "/mesa.html"
    },
    {
      "source": "/:empresa/cierre",
      "destination": "/cierre.html"
    },
    {
      "source": "/:empresa",
      "destination": "/index.html"
    }
  ]
}
